+static void alsa_watchdog_event(struct spa_source *source)
+{
+	struct state *state = source->data;
+	uint64_t expire;
+
+	if (spa_system_timerfd_read(state->data_system, state->timerfd, &expire) < 0 ||
+	    !state->rt.sources_added)
+		return;
+	spa_log_warn(state->log, "%s: graph cycle did not complete, waking up again",
+			state->name);
+	update_sources(state, true);
+}
+
+static bool has_watchdog(struct state *state)
+{
+	return state->disable_tsched && state->stream == SND_PCM_STREAM_PLAYBACK;
+}
+
