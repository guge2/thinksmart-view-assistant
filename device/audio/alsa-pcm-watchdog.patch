 			spa_loop_remove_source(state->data_loop, &state->source[i]);
+		if (has_watchdog(state)) {
+			set_timeout(state, 0);
+			spa_loop_remove_source(state->data_loop, &state->watchdog);
+		}
 		state->rt.sources_added = false;
 	}
 }
