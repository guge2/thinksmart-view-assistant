[Unit]
Description=ThinkSmart Voice Assistant
Wants=network-online.target user@1000.service
After=network-online.target sound.target user@1000.service
ConditionPathExists=/etc/thinksmart-voice/aliyun.json

[Service]
Type=simple
User=thinksmart
Group=thinksmart
SupplementaryGroups=audio
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/tmp
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/thinksmart-voice.conf
LoadCredential=aliyun.json:/etc/thinksmart-voice/aliyun.json
ExecStart=/data/thinksmart/voice/venv/bin/python3 /usr/local/lib/thinksmart-voice/assistant.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user/1000
ReadWritePaths=/data/thinksmart/music
RuntimeDirectory=thinksmart-voice
RuntimeDirectoryMode=0700
UMask=0077
MemoryMax=450M

[Install]
WantedBy=multi-user.target
