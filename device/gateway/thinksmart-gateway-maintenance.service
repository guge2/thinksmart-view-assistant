[Unit]
Description=Apply validated ThinkSmart management request
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/thinksmart-gateway/helper.py
TimeoutStartSec=120
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=thinksmart-gateway-helper
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/etc/thinksmart-voice /run/thinksmart-gateway /data/thinksmart/voice
RestrictAddressFamilies=AF_UNIX
